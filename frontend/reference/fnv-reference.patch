+using Mutagen.Bethesda.Plugins;
+using Mutagen.Bethesda.Plugins.Records;
+
+namespace NexusMods.Games.CreationEngine.Abstractions;
+
+public record PluginMaster(ModKey Master);
+
+// The installer and missing-master diagnostics need only header dependencies.
+public record PluginHeader(ModKey ModKey, IReadOnlyList<PluginMaster> MasterReferences)
+{
+    public static PluginHeader From(IMod mod) => new(mod.ModKey,
+        mod.MasterReferences.Select(master => new PluginMaster(master.Master)).ToArray());
+}
