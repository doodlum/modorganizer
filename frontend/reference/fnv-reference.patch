index 0000000..43c9b1c
--- /dev/null
+++ b/src/NexusMods.Games.CreationEngine/FalloutNewVegas/NewVegasPluginHeader.cs
@@ -0,0 +1,33 @@
+using System.Text;
+using Mutagen.Bethesda.Plugins;
+using NexusMods.Games.CreationEngine.Abstractions;
+
+namespace NexusMods.Games.CreationEngine.FalloutNewVegas;
+
+public static class NewVegasPluginHeader
+{
+    public static PluginHeader Read(Stream stream, string filename)
+    {
+        using var reader = new BinaryReader(stream, Encoding.UTF8, leaveOpen: true);
+        if (reader.ReadUInt32() != 0x34534554) throw new InvalidDataException("Expected a TES4 record header");
+        var size = reader.ReadUInt32();
+        if (size > 16 * 1024 * 1024) throw new InvalidDataException("Plugin header exceeds 16 MiB");
+        if (reader.ReadBytes(16).Length != 16) throw new EndOfStreamException();
+        var payload = reader.ReadBytes((int)size);
+        if (payload.Length != size) throw new EndOfStreamException();
+        using var records = new BinaryReader(new MemoryStream(payload));
+        var masters = new List<PluginMaster>();
+        while (records.BaseStream.Position < payload.Length)
+        {
+            var type = records.ReadUInt32();
+            var length = records.ReadUInt16();
+            var data = records.ReadBytes(length);
+            if (data.Length != length) throw new EndOfStreamException();
+            if (type != 0x5453414d) continue; // MAST
+            if (data.Length == 0 || data[^1] != 0) throw new InvalidDataException("Unterminated master name");
+            var master = Encoding.UTF8.GetString(data, 0, data.Length - 1);
+            masters.Add(new PluginMaster(ModKey.FromFileName(master)));
+        }
+        return new PluginHeader(ModKey.FromFileName(filename), masters);
+    }
+}
