@@ -0,0 +1,19 @@
+using NexusMods.Paths;
+using NexusMods.Sdk.IO;
+
+namespace NexusMods.Games.CreationEngine.FalloutNewVegas;
+
+// Resolve artwork from the user's Steam cache instead of redistributing game artwork.
+internal sealed class NewVegasArtwork(string name) : IStreamFactory
+{
+    public RelativePath FileName => name;
+    public ValueTask<Stream> GetStreamAsync()
+    {
+        var root = Environment.GetEnvironmentVariable("NMA_FNV_ARTWORK") ?? Path.Combine(
+            Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), ".local/share/Steam/appcache/librarycache/22380");
+        var path = Path.Combine(root, name);
+        if (File.Exists(path)) return ValueTask.FromResult<Stream>(File.OpenRead(path));
+        return new EmbeddedResourceStreamFactory<NewVegasArtwork>(
+            "NexusMods.Games.CreationEngine.Resources.FalloutNewVegas.fallback.png").GetStreamAsync();
+    }
+}
