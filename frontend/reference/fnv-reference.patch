@@ -0,0 +1,29 @@
+namespace NexusMods.Games.CreationEngine.FalloutNewVegas;
+
+public static class NewVegasLoadOrder
+{
+    // New Vegas reads activation from plugins.txt and ordering from file modification times.
+    public static void Apply(string dataDirectory, IEnumerable<string> activePlugins)
+    {
+        var plugins = activePlugins.Select(line => line.Trim())
+            .Where(line => line.Length != 0 && !line.StartsWith('#'))
+            .ToArray();
+        // Validate the complete list before changing anything on disk.
+        foreach (var plugin in plugins)
+        {
+            if (plugin.Contains('/') || plugin.Contains('\\') || plugin.StartsWith('*') ||
+                !(plugin.EndsWith(".esm", StringComparison.OrdinalIgnoreCase) || plugin.EndsWith(".esp", StringComparison.OrdinalIgnoreCase)))
+                throw new InvalidDataException($"Invalid New Vegas plugin filename: {plugin}");
+        }
+        var paths = plugins.Distinct(StringComparer.OrdinalIgnoreCase)
+            .Select(plugin => Path.Combine(dataDirectory, plugin)).ToArray();
+        foreach (var path in paths)
+            if (!File.Exists(path)) throw new FileNotFoundException("Active plugin is missing", path);
+        var timestamp = new DateTime(2000, 1, 1, 0, 0, 0, DateTimeKind.Utc);
+        foreach (var path in paths)
+        {
+            File.SetLastWriteTimeUtc(path, timestamp);
+            timestamp = timestamp.AddMinutes(1);
+        }
+    }
+}
diff --git a/src/NexusMods.Games.CreationEngine/FalloutNewVegas/NewVegasPluginHeader.cs b/src/NexusMods.Games.CreationEngine/FalloutNewVegas/NewVegasPluginHeader.cs
