+            // The live metadata feed can contain duplicate domains (for example two
+            // different IDs named "neverwinter"). Let the fallback resolve ambiguous
+            // entries instead of crashing Debug builds or choosing an arbitrary ID.
+            var distinct = pairs.Distinct().ToArray();
+            var duplicateIds = distinct.GroupBy(pair => pair.Id).Where(group => group.Count() > 1).Select(group => group.Key).ToHashSet();
+            var duplicateDomains = distinct.GroupBy(pair => pair.Domain).Where(group => group.Count() > 1).Select(group => group.Key).ToHashSet();
+            var unique = distinct.Where(pair => !duplicateIds.Contains(pair.Id) && !duplicateDomains.Contains(pair.Domain)).ToArray();
+            if (unique.Length != distinct.Length)
+                logger.LogWarning("Excluded {Count} ambiguous game mappings from local cache", distinct.Length - unique.Length);
+            gameIdToDomain = unique.ToFrozenDictionary(tuple => tuple.Id, tuple => tuple.Domain);
+            gameDomainToId = unique.ToFrozenDictionary(tuple => tuple.Domain, tuple => tuple.Id);
             return true;
