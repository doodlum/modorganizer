diff --git a/tools/FnvSmoke/Program.cs b/tools/FnvSmoke/Program.cs
new file mode 100644
index 0000000..7884a1c
--- /dev/null
+++ b/tools/FnvSmoke/Program.cs
@@ -0,0 +1,71 @@
+using System.Text;
+using NexusMods.Games.CreationEngine.FalloutNewVegas;
+
+static MemoryStream Plugin(params string[] masters)
+{
+    using var payload = new MemoryStream();
+    using (var data = new BinaryWriter(payload, Encoding.UTF8, true))
+        foreach (var master in masters)
+        {
+            var bytes = Encoding.UTF8.GetBytes(master + "\0");
+            data.Write(Encoding.ASCII.GetBytes("MAST")); data.Write((ushort)bytes.Length); data.Write(bytes);
+            data.Write(Encoding.ASCII.GetBytes("DATA")); data.Write((ushort)8); data.Write(0L);
+        }
+    var stream = new MemoryStream();
+    using (var writer = new BinaryWriter(stream, Encoding.UTF8, true))
+    {
+        writer.Write(Encoding.ASCII.GetBytes("TES4")); writer.Write((uint)payload.Length); writer.Write(new byte[16]); writer.Write(payload.ToArray());
+    }
+    stream.Position = 0; return stream;
+}
+
+using (var stream = Plugin("FalloutNV.esm", "DeadMoney.esm"))
+{
+    var header = NewVegasPluginHeader.Read(stream, "Example.esp");
+    if (header.ModKey.FileName.String != "Example.esp" || header.MasterReferences.Count != 2 ||
+        header.MasterReferences[1].Master.FileName.String != "DeadMoney.esm") throw new Exception("Master header parse failed");
+}
+using (var stream = Plugin())
+    if (NewVegasPluginHeader.Read(stream, "FalloutNV.esm").MasterReferences.Count != 0) throw new Exception("Base master failed");
+using (var stream = new MemoryStream(new byte[24]))
+{
+    try { NewVegasPluginHeader.Read(stream, "Bad.esp"); throw new Exception("Accepted malformed header"); }
+    catch (InvalidDataException) { }
+}
+using (var stream = Plugin("FalloutNV.esm"))
+{
+    stream.SetLength(stream.Length - 1);
+    try { NewVegasPluginHeader.Read(stream, "Truncated.esp"); throw new Exception("Accepted truncated header"); }
+    catch (EndOfStreamException) { }
+}
+var temporaryData = Path.Combine(Path.GetTempPath(), "nma-fnv-order-" + Guid.NewGuid());
+Directory.CreateDirectory(temporaryData);
+try
+{
+    foreach (var name in new[] { "FalloutNV.esm", "Example.esp" }) File.WriteAllBytes(Path.Combine(temporaryData, name), []);
+    NewVegasLoadOrder.Apply(temporaryData, ["# Fixture", "FalloutNV.esm", "Example.esp"]);
+    var original = File.GetLastWriteTimeUtc(Path.Combine(temporaryData, "FalloutNV.esm"));
+    if (original >= File.GetLastWriteTimeUtc(Path.Combine(temporaryData, "Example.esp"))) throw new Exception("Timestamp order failed");
+    try { NewVegasLoadOrder.Apply(temporaryData, ["../escape.esp"]); throw new Exception("Accepted path traversal"); }
+    catch (InvalidDataException) { }
+    if (original != File.GetLastWriteTimeUtc(Path.Combine(temporaryData, "FalloutNV.esm"))) throw new Exception("Invalid input changed files");
+}
+finally { Directory.Delete(temporaryData, recursive: true); }
+Console.WriteLine("PASS: timestamp load order in temporary fixture directory and invalid path rejection");
+Console.WriteLine("PASS: plugin masters, base master, invalid signature, truncated payload");
+if (args.Length > 0)
+{
+    var count = 0;
+    foreach (var file in Directory.EnumerateFiles(args[0]).Where(file => Path.GetExtension(file).Equals(".esm", StringComparison.OrdinalIgnoreCase) || Path.GetExtension(file).Equals(".esp", StringComparison.OrdinalIgnoreCase)))
+    {
+        using var stream = File.OpenRead(file);
+        var header = NewVegasPluginHeader.Read(stream, Path.GetFileName(file));
+        if (Path.GetFileName(file).Equals("DeadMoney.esm", StringComparison.OrdinalIgnoreCase) &&
+            !header.MasterReferences.Any(master => master.Master.FileName.String.Equals("FalloutNV.esm", StringComparison.OrdinalIgnoreCase)))
+            throw new Exception("DeadMoney.esm must reference FalloutNV.esm");
+        Console.WriteLine($"{header.ModKey}: {string.Join(", ", header.MasterReferences.Select(master => master.Master))}");
+        count++;
+    }
+    if (count == 0) throw new Exception("No installed plugins found");
+    Console.WriteLine($"PASS: read {count} installed plugin headers without writing game files");
+}
